{
  "name": "@fraktole/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fraktole": "./dist/fraktole.mjs"
  },
  "dependencies": {
    "@fraktole/core": "workspace:*",
    "@fraktole/daemon": "workspace:*",
    "ws": "catalog:",
    "@fraktole/tui": "workspace:*"
  },
  "scripts": {
