[Unit]
Description=Fraktole coding agent orchestrator daemon
After=network.target

[Service]
Type=simple
# Replace <user> with the account that owns the repositories the agents work on.
User=<user>
ExecStart=/usr/local/bin/fraktole-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
