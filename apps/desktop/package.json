{
  "name": "@fraktole/desktop",
  "desktopName": "Fraktole",
  "version": "0.14.0",
  "description": "Tiling command center for AI agents",
  "homepage": "https://fraktole.dev",
  "author": "Fraktole",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm build:main && concurrently -k -s first \"vite\" \"bash scripts/launcher.sh ./node_modules/.bin/electron .\"",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "pnpm build:main && pnpm build:renderer",
    "test": "vitest run",
    "test:e2e": "node scripts/driver-e2e.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint electron src tests",
    "postinstall": "electron-rebuild -f -w node-pty",
    "icon": "node scripts/icon.mjs",
    "installer": "bash scripts/make-installer.sh",
    "appimage": "pnpm build && pnpm exec electron-builder --linux AppImage",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/headless": "5.5.0",
    "codemirror": "^6.0.2",
    "node-pty": "^1.0.0",
    "react": "catalog:",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "catalog:",
    "sharp": "^0.34.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^6.1.0",
    "vitest": "catalog:"
  }
}
